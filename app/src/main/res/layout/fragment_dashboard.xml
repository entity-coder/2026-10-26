<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_shop_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shop_not_set"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_edit_shop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_shop_profile" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/today_sales_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_today_sales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/total_pending_dues_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_total_dues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/low_stock_alerts"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_low_stock_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_low_stock" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_low_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
